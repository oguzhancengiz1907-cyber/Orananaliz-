<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Oran Analiz</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="m-0 bg-[#f7f7f8] text-[#171717]">
<div id="oran-app" class="p-4 sm:p-6" style="background:#f7f7f8;color:#171717;border-radius:0;min-height:640px;">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-4 lg:grid-cols-[340px_1fr]">
      <section class="rounded-2xl border p-4" style="background:light-dark(#ffffff,#191b1f);border-color:light-dark(#e5e7eb,#2a2d33);">
        <div class="mb-4">
          <div class="text-sm font-semibold">Arama kriterleri</div>
          <div class="mt-1 text-xs opacity-65">Lig ve oranı seç, geçmiş maçları bul.</div>
          <div class="mt-2 rounded-xl border border-dashed p-3 text-xs opacity-75" style="border-color:light-dark(#d7d9dd,#383c44);">
            Excel/CSV verisi yüklemek için aşağıdaki dosya alanını kullan. Uygulama sütun adlarını otomatik eşleştirir.
          </div>
        </div>

        <form id="filter-form" class="space-y-4">
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Veri dosyası</span>
            <input id="data-file" type="file" accept=".csv,.txt" class="block w-full rounded-xl border px-3 py-3 text-sm" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);" />
            <span id="data-status" class="mt-1.5 block text-xs opacity-65">Geçmiş veri yüklenmedi.</span>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Lig</span>
            <select id="league" class="w-full rounded-xl border px-3 py-3 text-base" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);">
              <option value="all">Tüm Ligler</option>
              <option>Premier League</option>
              <option>La Liga</option>
              <option>Serie A</option>
              <option>Bundesliga</option>
              <option>Ligue 1</option>
              <option>Süper Lig</option>
              <option>Şampiyonlar Ligi</option>
              <option>Avrupa Ligi</option>
              <option>Konferans Ligi</option>
            </select>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Oran türü</span>
            <select id="market" class="w-full rounded-xl border px-3 py-3 text-base" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);">
              <option value="ms1">MS 1</option>
              <option value="x">MS X</option>
              <option value="ms2">MS 2</option>
              <option value="iy15">İY 1.5 Üst</option>
            </select>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Oran</span>
            <input id="odd" inputmode="decimal" type="number" min="1.01" max="20" step="0.01" value="1.50" class="w-full rounded-xl border px-3 py-3 text-base" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);" />
          </label>

          <fieldset>
            <legend class="mb-2 text-sm font-medium">Tolerans</legend>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex min-h-11 items-center gap-2 rounded-xl border px-3" style="border-color:light-dark(#d7d9dd,#383c44);"><input type="radio" name="tol" value="0" /> <span class="text-sm">Tam oran</span></label>
              <label class="flex min-h-11 items-center gap-2 rounded-xl border px-3" style="border-color:light-dark(#d7d9dd,#383c44);"><input type="radio" name="tol" value="0.01" /> <span class="text-sm">±0.01</span></label>
              <label class="flex min-h-11 items-center gap-2 rounded-xl border px-3" style="border-color:light-dark(#d7d9dd,#383c44);"><input type="radio" name="tol" value="0.02" checked /> <span class="text-sm">±0.02</span></label>
              <label class="flex min-h-11 items-center gap-2 rounded-xl border px-3" style="border-color:light-dark(#d7d9dd,#383c44);"><input type="radio" name="tol" value="0.05" /> <span class="text-sm">±0.05</span></label>
            </div>
          </fieldset>

          <button type="submit" class="min-h-12 w-full rounded-xl px-4 font-semibold" style="background:light-dark(#171717,#f2f2f2);color:light-dark(#fff,#171717);">Geçmiş Maçları Bul</button>
          <p id="error" class="hidden text-sm" style="color:#c2410c;" role="alert"></p>
        </form>
      </section>

      <section class="min-w-0 space-y-4">
        <div class="rounded-2xl border p-4" style="background:light-dark(#ffffff,#191b1f);border-color:light-dark(#e5e7eb,#2a2d33);">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="text-sm font-semibold">Bugünün maçları</div>
              <div class="text-xs opacity-65">Maçkolik odaklı akış: güncel bülteni al, oranları geçmiş arşivle eşleştir.</div>
            </div>
            <button id="today-refresh" type="button" class="min-h-11 rounded-xl border px-4 text-sm font-semibold" style="border-color:light-dark(#d7d9dd,#383c44);">Bugünü yenile</button>
          </div>
          <div class="mt-3 grid gap-2 sm:grid-cols-[1fr_1fr]">
            <label class="block">
              <span class="mb-1 block text-xs font-medium opacity-70">Maç kaynağı</span>
              <select id="live-source" class="min-h-11 w-full rounded-xl border px-3 text-base" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);">
                <option value="mackolik">Maçkolik aktarım katmanı</option>
                <option value="api-football">API-Football yedek</option>
                <option value="nesine" disabled>Nesine — resmi erişim gerekli</option>
              </select>
            </label>
            <div class="rounded-xl border border-dashed p-3 text-xs opacity-75" style="border-color:light-dark(#d7d9dd,#383c44);">
              Maçkolik için uygulama doğrudan siteye bağlanmak yerine bir aktarım adresinden JSON bekleyecek. Böylece site yapısı değişse bile uygulama tarafı sabit kalacak.
            </div>
          </div>
          <div class="mt-2 grid gap-2 sm:grid-cols-[1fr_auto]">
            <input id="api-key" type="text" autocomplete="off" value="https://script.google.com/macros/s/AKfycbxkj9lRAOwOUciBAwyXQ3ysmAzYdfFLDgkhKDmjkRZQjH2jHesxZoU5YacL34xeFbcb/exec" placeholder="Maçkolik aktarım adresi veya API-Football Key" class="min-h-11 w-full rounded-xl border px-3 text-base" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);" />
            <button id="api-save" type="button" class="min-h-11 rounded-xl border px-4 text-sm font-semibold" style="border-color:light-dark(#d7d9dd,#383c44);">Kaynağı bağla</button>
          </div>
          <div id="today-status" class="mt-3 rounded-xl border border-dashed p-3 text-sm opacity-75" style="border-color:light-dark(#d7d9dd,#383c44);">
            Maçkolik aktarım adresi hazır. “Bugünü yenile” ile bağlantı ve JSON çıktısı test edilecek.
          </div>
          <div id="today-results" class="mt-3 space-y-2"></div>
        </div>
        <div id="summary" class="grid grid-cols-2 gap-3 sm:grid-cols-4" aria-live="polite"></div>

        <div class="rounded-2xl border p-4" style="background:light-dark(#ffffff,#191b1f);border-color:light-dark(#e5e7eb,#2a2d33);">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <div>
              <div class="text-sm font-semibold">Bulunan geçmiş maçlar</div>
              <div id="range-text" class="text-xs opacity-65"></div>
            </div>
            <select id="sort" class="rounded-lg border px-2 py-2 text-sm" style="background:light-dark(#fff,#202329);border-color:light-dark(#d7d9dd,#383c44);">
              <option value="date-desc">En yeni</option>
              <option value="date-asc">En eski</option>
              <option value="odd-asc">Oran ↑</option>
              <option value="odd-desc">Oran ↓</option>
            </select>
          </div>
          <div id="results" class="space-y-2"></div>
        </div>
      </section>
    </div>
  </div>
</div>
<script>
(() => {
  const root = document.getElementById('oran-app');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  let matches = [];

  const form = root.querySelector('#filter-form');
  const results = root.querySelector('#results');
  const summary = root.querySelector('#summary');
  const rangeText = root.querySelector('#range-text');
  const error = root.querySelector('#error');
  const sort = root.querySelector('#sort');
  const dataFile = root.querySelector('#data-file');
  const dataStatus = root.querySelector('#data-status');
  const todayRefresh = root.querySelector('#today-refresh');
  const todayStatus = root.querySelector('#today-status');
  const todayResults = root.querySelector('#today-results');
  const apiKeyInput = root.querySelector('#api-key');
  const apiSave = root.querySelector('#api-save');
  const liveSource = root.querySelector('#live-source');
  let current = [];
  let currentMarket = 'ms1';
  let liveApiKey = '';
  let mackolikEndpoint = 'https://script.google.com/macros/s/AKfycbxkj9lRAOwOUciBAwyXQ3ysmAzYdfFLDgkhKDmjkRZQjH2jHesxZoU5YacL34xeFbcb/exec';

  const parseScore = s => s.split('-').map(Number);
  const pct = (n,d) => d ? Math.round((n/d)*100) : 0;
  const marketLabel = {ms1:'MS 1',x:'MS X',ms2:'MS 2',iy15:'İY 1.5 Üst'};

  function normalizeHeader(value){
    return String(value || '')
      .trim()
      .toLocaleLowerCase('tr-TR')
      .replace(/ı/g,'i').replace(/ş/g,'s').replace(/ğ/g,'g').replace(/ü/g,'u').replace(/ö/g,'o').replace(/ç/g,'c')
      .replace(/[^a-z0-9]+/g,'');
  }

  function parseOdd(value){
    if(value == null || value === '') return null;
    const num = Number(String(value).trim().replace(',','.'));
    return Number.isFinite(num) ? num : null;
  }

  function detectDelimiter(line){
    const candidates = [',',';','\t'];
    let best = ',', bestCount = -1;
    candidates.forEach(d=>{
      const count = line.split(d).length;
      if(count > bestCount){ best = d; bestCount = count; }
    });
    return best;
  }

  function splitCsvLine(line, delimiter){
    const out = [];
    let cur = '', quoted = false;
    for(let i=0;i<line.length;i++){
      const ch = line[i];
      if(ch === '"'){
        if(quoted && line[i+1] === '"'){ cur += '"'; i++; }
        else quoted = !quoted;
      } else if(ch === delimiter && !quoted){
        out.push(cur.trim()); cur = '';
      } else cur += ch;
    }
    out.push(cur.trim());
    return out;
  }

  function findIndex(headers, aliases){
    const normalized = headers.map(normalizeHeader);
    for(const alias of aliases){
      const idx = normalized.indexOf(normalizeHeader(alias));
      if(idx >= 0) return idx;
    }
    return -1;
  }

  function buildMatchesFromCsv(text){
    const lines = String(text || '').replace(/^\uFEFF/,'').split(/\r?\n/).filter(line=>line.trim().length);
    if(lines.length < 2) throw new Error('Dosyada yeterli satır yok.');
    const delimiter = detectDelimiter(lines[0]);
    const headers = splitCsvLine(lines[0], delimiter);
    const idx = {
      date: findIndex(headers,['Tarih','Date']),
      league: findIndex(headers,['Lig','League']),
      home: findIndex(headers,['Ev Sahibi','Ev','Home','Home Team','HomeTeam']),
      away: findIndex(headers,['Deplasman','Dep','Away','Away Team','AwayTeam']),
      ms1: findIndex(headers,['MS1','MS 1','1','Home Odds','Odd 1']),
      x: findIndex(headers,['MS0','MS X','X','Beraberlik','Draw Odds','Odd X']),
      ms2: findIndex(headers,['MS2','MS 2','2','Away Odds','Odd 2']),
      iy15: findIndex(headers,['İY 1.5 Üst','IY 1.5 Ust','İY1.5Üst','IY15','HT Over 1.5']),
      ht: findIndex(headers,['İY','IY','İlk Yarı','Ilk Yari','HT','Half Time']),
      ft: findIndex(headers,['MS','Maç Sonucu','Mac Sonucu','FT','Full Time','Skor'])
    };
    const essential = ['date','league','home','away','ms1','x','ms2','ft'];
    const missing = essential.filter(k=>idx[k] < 0);
    if(missing.length) throw new Error('Gerekli sütunlar bulunamadı: ' + missing.join(', '));

    const parsed = [];
    for(let i=1;i<lines.length;i++){
      const row = splitCsvLine(lines[i], delimiter);
      const ms1 = parseOdd(row[idx.ms1]), x = parseOdd(row[idx.x]), ms2 = parseOdd(row[idx.ms2]);
      if(ms1 == null || x == null || ms2 == null) continue;
      const ft = String(row[idx.ft] || '').trim();
      if(!/^\d+\s*[-:]\s*\d+$/.test(ft)) continue;
      const htRaw = idx.ht >= 0 ? String(row[idx.ht] || '').trim() : '';
      parsed.push({
        date:String(row[idx.date] || '').trim(),
        league:String(row[idx.league] || '').trim(),
        home:String(row[idx.home] || '').trim(),
        away:String(row[idx.away] || '').trim(),
        ms1,
        x,
        ms2,
        iy15: idx.iy15 >= 0 ? (parseOdd(row[idx.iy15]) ?? 0) : 0,
        ht:/^\d+\s*[-:]\s*\d+$/.test(htRaw) ? htRaw.replace(':','-').replace(/\s/g,'') : '0-0',
        ft:ft.replace(':','-').replace(/\s/g,'')
      });
    }
    if(!parsed.length) throw new Error('Geçerli maç satırı bulunamadı.');
    return parsed;
  }

  function outcome(m){
    const [h,a] = parseScore(m.ft);
    if(h>a) return 'MS1';
    if(h<a) return 'MS2';
    return 'X';
  }

  function card(label,value,sub){
    return `<div class="rounded-2xl border p-3" style="background:light-dark(#ffffff,#191b1f);border-color:light-dark(#e5e7eb,#2a2d33);"><div class="text-xs opacity-60">${label}</div><div class="mt-1 text-xl font-bold">${value}</div><div class="mt-0.5 text-xs opacity-65">${sub}</div></div>`;
  }

  function renderSummary(list){
    const total = list.length;
    const ms1 = list.filter(m=>outcome(m)==='MS1').length;
    const draw = list.filter(m=>outcome(m)==='X').length;
    const ms2 = list.filter(m=>outcome(m)==='MS2').length;
    const htOver = list.filter(m=>{const [h,a]=parseScore(m.ht); return h+a>=2;}).length;
    summary.innerHTML = card('Maç',total,'eşleşme bulundu') + card('MS1',`${pct(ms1,total)}%`,`${ms1}/${total} maç`) + card('Beraberlik',`${pct(draw,total)}%`,`${draw}/${total} maç`) + card('İY 1.5 Üst',`${pct(htOver,total)}%`,`${htOver}/${total} maç`);
  }

  function sortList(list){
    const mode = sort.value;
    return [...list].sort((a,b)=>{
      if(mode==='date-desc') return b.date.localeCompare(a.date);
      if(mode==='date-asc') return a.date.localeCompare(b.date);
      if(mode==='odd-asc') return a[currentMarket]-b[currentMarket];
      return b[currentMarket]-a[currentMarket];
    });
  }

  function renderResults(){
    const list = sortList(current);
    if(!list.length){
      results.innerHTML = `<div class="rounded-xl border border-dashed p-6 text-center text-sm opacity-65">Bu kriterde geçmiş maç bulunamadı. Önce Excel/CSV arşivini yükle.</div>`;
      return;
    }
    results.innerHTML = list.map(m=>{
      const [hh,ha]=parseScore(m.ht); const htOver=hh+ha>=2;
      return `<article class="rounded-xl border p-3" style="border-color:light-dark(#e5e7eb,#2a2d33);">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="text-xs opacity-55">${m.date} · ${m.league}</div>
            <div class="mt-1 font-semibold">${m.home} — ${m.away}</div>
          </div>
          <div class="rounded-lg px-2.5 py-1 text-sm font-bold" style="background:light-dark(#f1f2f4,#252930);">${marketLabel[currentMarket]} ${m[currentMarket].toFixed(2)}</div>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4 text-sm">
          <div><span class="opacity-55">İY:</span> <b>${m.ht}</b></div>
          <div><span class="opacity-55">MS:</span> <b>${m.ft}</b></div>
          <div><span class="opacity-55">Sonuç:</span> <b>${outcome(m)}</b></div>
          <div><span class="opacity-55">İY 1.5:</span> <b>${htOver?'ÜST':'ALT'}</b></div>
        </div>
      </article>`;
    }).join('');
  }

  function runSearch(){
    error.classList.add('hidden');
    const league = root.querySelector('#league').value;
    currentMarket = root.querySelector('#market').value;
    const odd = Number(root.querySelector('#odd').value);
    const tol = Number(root.querySelector('input[name="tol"]:checked').value);
    if(!Number.isFinite(odd) || odd < 1.01 || odd > 20){
      error.textContent='Geçerli bir oran gir (1.01–20.00).'; error.classList.remove('hidden'); return;
    }
    const low = odd-tol, high = odd+tol;
    current = matches.filter(m => (league==='all' || m.league===league) && m[currentMarket] >= low-0.0001 && m[currentMarket] <= high+0.0001);
    rangeText.textContent = tol===0 ? `${marketLabel[currentMarket]} tam ${odd.toFixed(2)}` : `${marketLabel[currentMarket]} ${low.toFixed(2)}–${high.toFixed(2)} aralığı`;
    renderSummary(current); renderResults();
  }

  function normalizeLiveMatch(item){
    const source = item || {};
    const teams = source.teams || {};
    const fixture = source.fixture || {};
    const league = source.league || {};
    const odds = source.odds || source.bookmaker || source.prices || {};
    const home = source.home || source.homeTeam || source.home_team || teams.home?.name || teams.home || '';
    const away = source.away || source.awayTeam || source.away_team || teams.away?.name || teams.away || '';
    const date = source.date || source.kickoff || source.start_time || fixture.date || '';
    const leagueName = typeof league === 'string' ? league : (league.name || source.leagueName || source.competition || 'Lig');
    const ms1 = parseOdd(source.ms1 ?? source.homeOdd ?? source.home_odd ?? odds.ms1 ?? odds.home ?? odds['1']);
    const x = parseOdd(source.x ?? source.drawOdd ?? source.draw_odd ?? odds.x ?? odds.draw ?? odds['X']);
    const ms2 = parseOdd(source.ms2 ?? source.awayOdd ?? source.away_odd ?? odds.ms2 ?? odds.away ?? odds['2']);
    if(!home || !away) return null;
    return {date:String(date),league:String(leagueName),home:String(home),away:String(away),ms1,x,ms2};
  }

  function todayIso(){
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth()+1).padStart(2,'0');
    const d = String(now.getDate()).padStart(2,'0');
    return `${y}-${m}-${d}`;
  }

  function matchWinnerOdds(oddItem){
    const bookmakers = Array.isArray(oddItem?.bookmakers) ? oddItem.bookmakers : [];
    for(const bookmaker of bookmakers){
      const bets = Array.isArray(bookmaker?.bets) ? bookmaker.bets : [];
      const market = bets.find(b=>String(b?.name || '').toLowerCase()==='match winner');
      if(!market) continue;
      const values = Array.isArray(market.values) ? market.values : [];
      const get = name => parseOdd(values.find(v=>String(v?.value || '').toLowerCase()===name)?.odd);
      const ms1 = get('home'), x = get('draw'), ms2 = get('away');
      if(ms1 != null || x != null || ms2 != null) return {ms1,x,ms2};
    }
    return {ms1:null,x:null,ms2:null};
  }

  function mergeApiFootball(fixturesPayload, oddsPayload){
    const fixtures = Array.isArray(fixturesPayload?.response) ? fixturesPayload.response : [];
    const odds = Array.isArray(oddsPayload?.response) ? oddsPayload.response : [];
    const oddsByFixture = new Map();
    odds.forEach(o=>{
      const id = o?.fixture?.id;
      if(id != null) oddsByFixture.set(String(id), matchWinnerOdds(o));
    });
    return fixtures.map(f=>{
      const id = f?.fixture?.id;
      const prices = oddsByFixture.get(String(id)) || {ms1:null,x:null,ms2:null};
      return {
        date:String(f?.fixture?.date || ''),
        league:String(f?.league?.name || 'Lig'),
        home:String(f?.teams?.home?.name || ''),
        away:String(f?.teams?.away?.name || ''),
        ms1:prices.ms1,
        x:prices.x,
        ms2:prices.ms2
      };
    }).filter(m=>m.home && m.away).slice(0,250);
  }

  function extractLiveMatches(payload){
    const candidates = Array.isArray(payload) ? payload : (payload.response || payload.matches || payload.data || payload.events || []);
    if(!Array.isArray(candidates)) return [];
    return candidates.map(normalizeLiveMatch).filter(Boolean).slice(0,200);
  }

  function historicalSummaryForLive(m){
    if(m.ms1 == null) return 'MS1 oranı yok';
    const found = matches.filter(h=>h.league===m.league && Math.abs(h.ms1-m.ms1)<=0.02);
    if(!found.length) return 'Geçmiş eşleşme yok';
    const wins = found.filter(h=>outcome(h)==='MS1').length;
    return `${found.length} benzer maç · MS1 %${pct(wins,found.length)}`;
  }

  function renderToday(list){
    if(!list.length){
      todayResults.innerHTML = '<div class="rounded-xl border border-dashed p-4 text-sm opacity-70" style="border-color:light-dark(#d7d9dd,#383c44);">API yanıtında gösterilebilir maç bulunamadı.</div>';
      return;
    }
    todayResults.innerHTML = list.map(m=>`<article class="rounded-xl border p-3" style="border-color:light-dark(#e5e7eb,#2a2d33);">
      <div class="text-xs opacity-55">${m.date || 'Tarih yok'} · ${m.league}</div>
      <div class="mt-1 font-semibold">${m.home} — ${m.away}</div>
      <div class="mt-2 flex flex-wrap gap-2 text-sm">
        <span class="rounded-lg px-2 py-1" style="background:light-dark(#f1f2f4,#252930);">MS1 ${m.ms1==null?'—':m.ms1.toFixed(2)}</span>
        <span class="rounded-lg px-2 py-1" style="background:light-dark(#f1f2f4,#252930);">X ${m.x==null?'—':m.x.toFixed(2)}</span>
        <span class="rounded-lg px-2 py-1" style="background:light-dark(#f1f2f4,#252930);">MS2 ${m.ms2==null?'—':m.ms2.toFixed(2)}</span>
      </div>
      <div class="mt-2 text-xs opacity-70">${historicalSummaryForLive(m)}</div>
    </article>`).join('');
  }

  async function loadToday(){
    const source = liveSource.value;
    if(source === 'mackolik' && !mackolikEndpoint){ todayStatus.textContent = 'Önce Maçkolik aktarım adresini gir.'; return; }
    if(source === 'api-football' && !liveApiKey){ todayStatus.textContent = 'Önce API-Football anahtarını gir.'; return; }
    todayStatus.textContent = 'Güncel maçlar çekiliyor…';
    todayRefresh.disabled = true;
    try{
      const date = todayIso();
      if(source === 'mackolik'){
        const separator = mackolikEndpoint.includes('?') ? '&' : '?';
        const response = await fetch(`${mackolikEndpoint}${separator}date=${encodeURIComponent(date)}`,{headers:{'Accept':'application/json'}});
        if(!response.ok) throw new Error(`Maçkolik aktarım HTTP ${response.status}`);
        const raw = await response.text();
        let payload;
        try { payload = JSON.parse(raw); }
        catch (_) { throw new Error(`Aktarım JSON döndürmüyor. Gelen veri: ${raw.slice(0,120)}`); }
        if(payload && payload.success === false) throw new Error(payload.message || 'Aktarım servisi başarısız yanıt verdi');
        const live = extractLiveMatches(payload);
        if(!live.length){
          const keys = payload && typeof payload === 'object' ? Object.keys(payload).join(', ') : 'yok';
          throw new Error(`JSON geldi ama maç listesi yok. Alanlar: ${keys}`);
        }
        const withOdds = live.filter(m=>m.ms1!=null || m.x!=null || m.ms2!=null).length;
        todayStatus.textContent = `${date}: Maçkolik aktarımından ${live.length} maç alındı · ${withOdds} maçta MS oranı bulundu.`;
        renderToday(live);
        return;
      }
      const headers = {'Accept':'application/json','x-apisports-key':liveApiKey};
      const [fixturesResponse,oddsResponse] = await Promise.all([
        fetch(`https://v3.football.api-sports.io/fixtures?date=${encodeURIComponent(date)}`,{headers}),
        fetch(`https://v3.football.api-sports.io/odds?date=${encodeURIComponent(date)}&page=1`,{headers})
      ]);
      if(!fixturesResponse.ok) throw new Error(`Fikstür HTTP ${fixturesResponse.status}`);
      if(!oddsResponse.ok) throw new Error(`Oran HTTP ${oddsResponse.status}`);
      const fixturesPayload = await fixturesResponse.json();
      const oddsPayload = await oddsResponse.json();
      const apiErrors = [fixturesPayload?.errors, oddsPayload?.errors].filter(e=>e && Object.keys(e).length);
      if(apiErrors.length) throw new Error('API erişim hatası');
      const live = mergeApiFootball(fixturesPayload, oddsPayload);
      const withOdds = live.filter(m=>m.ms1!=null || m.x!=null || m.ms2!=null).length;
      todayStatus.textContent = `${date}: ${live.length} maç alındı · ${withOdds} maçta MS oranı bulundu.`;
      renderToday(live);
    } catch(err){
      todayStatus.textContent = `Canlı veri alınamadı: ${err.message}. API anahtarını, paket limitini ve tarayıcı erişimini kontrol et.`;
      todayResults.innerHTML = '';
    } finally {
      todayRefresh.disabled = false;
    }
  }

  form.addEventListener('submit', e=>{e.preventDefault();runSearch();});
  sort.addEventListener('change', renderResults);
  dataFile.addEventListener('change', e=>{
    const file = e.target.files && e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try{
        matches = buildMatchesFromCsv(reader.result);
        dataStatus.textContent = `${file.name}: ${matches.length} maç yüklendi.`;
        const leagues = [...new Set(matches.map(m=>m.league).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'tr'));
        const leagueSelect = root.querySelector('#league');
        leagueSelect.innerHTML = '<option value="all">Tüm Ligler</option>' + leagues.map(l=>`<option>${l}</option>`).join('');
        runSearch();
      } catch(err){
        matches = [];
        dataStatus.textContent = `Dosya okunamadı: ${err.message}`;
        runSearch();
      }
    };
    reader.onerror = () => { dataStatus.textContent = 'Dosya okunamadı.'; };
    reader.readAsText(file,'utf-8');
  });
  apiSave.addEventListener('click', ()=>{
    const value = String(apiKeyInput.value || '').trim();
    if(liveSource.value === 'mackolik'){
      if(!/^https?:\/\//i.test(value)){ todayStatus.textContent = 'Geçerli bir Maçkolik aktarım adresi gir.'; return; }
      mackolikEndpoint = value;
      todayStatus.textContent = 'Maçkolik aktarım bağlantısı hazır. “Bugünü yenile” ile veriyi çekebilirsin.';
      return;
    }
    if(value.length < 16){ todayStatus.textContent = 'Geçerli API-Football anahtarını gir.'; return; }
    liveApiKey = value;
    todayStatus.textContent = 'API-Football bağlantısı hazır. “Bugünü yenile” ile maçları çekebilirsin.';
  });
  liveSource.addEventListener('change', ()=>{
    apiKeyInput.value = '';
    if(liveSource.value === 'mackolik'){
      apiKeyInput.type = 'text';
      apiKeyInput.placeholder = 'Maçkolik aktarım adresi (https://...)';
      todayStatus.textContent = 'Maçkolik seçildi. Aktarım adresini girip kaynağı bağla.';
    } else {
      apiKeyInput.type = 'password';
      apiKeyInput.placeholder = 'API-Football API Key';
      todayStatus.textContent = 'API-Football seçildi. API anahtarını girip kaynağı bağla.';
    }
  });
  todayRefresh.addEventListener('click', loadToday);
  runSearch();
})();
</script>
</body>
</html>
